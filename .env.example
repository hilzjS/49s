# UK49s Prediction Platform — environment variables (reference only)
#
# NOTE: Values marked as placeholders are secret. Never commit real values.
# In Dyad, set these as environment variables / secrets for the app rather
# than relying on a committed .env file.

# --- NEW Supabase PostgreSQL connection --------------------------------
# Use the connection string from: Supabase Dashboard -> Project Settings ->
# Database -> Connection string (URI). Use the "Connection pooling" /
# Supavisor URI (recommended) or the direct connection URI.
# Keep this server-side only — it contains the database password.
DATABASE_URL=<NEW_SUPABASE_DATABASE_URL>

# Optional TLS override. Leave unset for Supabase (TLS is enabled
# automatically for non-local hosts). Set to "false" to disable TLS when
# running against a local PostgreSQL without TLS.
# DATABASE_SSL=false

# --- Application -------------------------------------------------------
# Shared secret that protects administrative endpoints (ingest, backtest,
# optimize, predict). Required in production.
ADMIN_API_KEY=<STRONG_ADMIN_API_KEY>

# API server port (the preview/dev script sets this automatically).
PORT=3000

# Optional: pino log level (info | warn | error | debug | trace).
# LOG_LEVEL=info